# Copy to backend/.env and fill in. backend/.env is gitignored - never commit it.

# Generate one with:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Mount point for Django admin. Leave at the default for dev; a real
# deployment should move it off "admin/".
DJANGO_ADMIN_URL=admin/

# Where the React SPA runs - used to build links in verification / password
# reset / email-change-confirmation emails.
FRONTEND_URL=http://localhost:5173

# The SPA origin(s). Comma-separated, no trailing slash. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# Reserved for marketdata (step B3) - not used by any code yet.
FMP_API_KEY=

# Only read by config.settings.prod (dev uses the console email backend).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
